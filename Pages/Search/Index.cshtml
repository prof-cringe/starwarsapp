@page
@model starwarsapp.Pages.Search.IndexModel
@{
    ViewData["Title"] = "Pesquisa";
}

<h1 class="h3 mb-4">Pesquisa</h1>

<form method="get" class="row gy-2 gx-3 align-items-center mb-4">
    <div class="col-sm-6">
        <input class="form-control" type="search" name="q" value="@Model.Q" placeholder="Buscar por nome na api..." />
    </div>
    <div class="col-sm-4">
        <select class="form-select" name="type">
            <option value="all" selected="@("all"==Model.Type)">Todas as Categorias</option>
            <option value="people" selected="@("people"==Model.Type)">Personagens</option>
            <option value="planets" selected="@("planets" == Model.Type)">Planetas</option>
            <option value="species" selected="@("species" == Model.Type)">Criaturas</option>
            <option value="starships" selected="@("starships" == Model.Type)">Naves</option>
            <option value="vehicles" selected="@("vehicles" == Model.Type)">Veículos</option>
        </select>
    </div>
    <div class="col-sm-2">
        <button class="btn btn-primary w-100">Pesquisar</button>
    </div>
</form>

<div class="row g-4">
    @foreach (var c in Model.Results)
    {
        <div class="col-12 col-sm-6 com-md-4 col-lg-3">
            <a class="text-decoration-none" asp-page="/Details" asp-route-type="@c.Type" asp-route-id="@c.id">
                <div class="card card-sw p-3 h-100">
                    <img class="img-fit" src="@c.Img" alt="@c.Title" onerror="this.onerror=null;this.src='/img/placeholder.svg';" />
                    <div class="mt-3">
                        <div class="title">@c.Title</div>
                        <small class="text-secondary">@c.Subtitle</small>
                    </div>
                </div>    
            </a>
        </div>
    }
</div>
