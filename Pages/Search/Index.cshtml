@page
@model starwarsapp.Pages.Search.IndexModel
@{
    ViewData["Title"] = "STAR WARS - Página Principal";
}

<section class="mb-5">
    <h1 class="display-5 fw-bold">Explorando a franquia Star Wars!</h1>
    <p class="lead text-secondary">
        Personagens, Planetas, Criaturas e todo o tipo de doidice
    </p>
</section>

<!-- People -->
<section class="mb-5">
    <div class="d-flex align-items-center mb-3">
        <h2 class="h3 mb-0 me-3">Personagens</h2>
        <span class="badge badge-cat">people</span>
    </div>
    <div class="row g-4">
        @foreach (var p in Model.People)
        {
            <div class="col col-sm-6 col-sm-4 col-lg-3">
                <a class="text-decoration-none" asp-page="/Details" asp-route-id="@p.id">
                    <div class="card card-sw p-3 h-100">
                        <img class="img-fit" src="@p.Img" alt="@p.Title" onerror="this.onerror=null;this.src='/img/placeholder.png'" />
                        <div class="mt-3">
                            <div class="title">@p.Title</div>
                            <small class="text-secondary">@p.Subtitle</small>
                        </div>
                    </div>
                </a> 
            </div>
        }
    </div>
</section>

