@page
@model Microsoft.AspNetCore.Mvc.RazorPages.PageModel
@{
    ViewData["Title"] = "Sobre o Projeto";
}

<div class="card card-sw p-4">
    <h1 class="mb-3">Sobre</h1>
    <p>Exemplo em Razor Pages (.NET 8) consumindo a SWAPI (swapi.info) para listar personagens, planetas, espécies e outros.</p>
    <ul>
        <li>Dados: <a href="https://swapi.info" target="_blank" rel="noopener">swapi.info</a></li>
        <li>Imagens: API comunitária "Star Wars Databank" (links oficiais)</li>
        <li>UI: Bootstrap 5 + CSS custom</li>
    </ul>
</div>
